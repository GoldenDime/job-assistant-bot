# Скопируйте в .env и заполните. Файл .env не коммитится.
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Курс для пересчёта стоимости в рубли
USD_RUB=80
# Пусто = события пишутся только в лог
AMPLITUDE_API_KEY=
# Соль для хэширования Telegram id перед отправкой в аналитику
USER_ID_SALT=change-me
